NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave de servidor para proteger operaciones de escritura en /admin (NUNCA expuesta al navegador)
ADMIN_PASSCODE=cambridge1996-demo

# Opcional: Token de servidor para subir nuevas fotografías a Vercel Blob desde /admin
# Si se omite, el sitio funciona 100% con el contenido estático en public/images y src/data
BLOB_READ_WRITE_TOKEN=

# Opcional: Formulario externo Tally (mostrar solo cuando su información sea verificada)
NEXT_PUBLIC_TALLY_VERIFIED=false
NEXT_PUBLIC_TALLY_URL=https://tally.so/r/NpoEVO
